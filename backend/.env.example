# PackSense AI Backend Configuration

# Server
PROJECT_NAME="PackSense AI"
API_V1_STR="/api/v1"
SECRET_KEY="packsense_ai_production_secret_key_change_in_prod"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./packaging_system.db"
# For PostgreSQL: DATABASE_URL="postgresql://user:password@localhost:5432/packsense_db"

# AI Integration (Google Gemini API)
# Get key from Google AI Studio / Antigravity Platform
ANTIGRAVITY_API_KEY=""
GEMINI_API_KEY=""

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]
